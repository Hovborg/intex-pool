{
  "config": {
    "step": {
      "user": {
        "title": "Intex Pool — Tuya cloud",
        "description": "Enter your Tuya IoT developer-cloud credentials once. Your devices and their local keys are discovered automatically, and IPs are found on your network — no manual key or IP entry. (Tick “set up manually” if you'd rather enter everything by hand.)",
        "data": {
          "region": "Region",
          "access_id": "Access ID",
          "access_secret": "Access secret",
          "manual": "Set up manually instead (no cloud)"
        }
      },
      "discover": {
        "title": "Select your pool devices",
        "description": "Pick which of your discovered devices are the pool equipment. Local keys and IPs are filled in automatically. Leave a field empty if you don't have that device.",
        "data": {
          "sensor": "Water quality sensor",
          "saltwater": "Saltwater system",
          "pump_tuya": "Sand filter pump (Tuya device)",
          "pump_switch": "Sand filter pump — existing switch (any brand)",
          "pump_power": "Pump power sensor (optional)",
          "pump_energy": "Pump energy sensor (optional)"
        }
      },
      "manual": {
        "title": "Manual setup",
        "description": "Select the equipment you have. You can pick any combination.",
        "data": {
          "has_sensor": "Water quality sensor",
          "has_salt": "Saltwater system",
          "has_pump": "Sand filter pump"
        }
      },
      "sensor": {
        "title": "Water sensor (cloud)",
        "description": "Enter your Tuya IoT developer-cloud credentials and the sensor's device id.",
        "data": {
          "region": "Region",
          "access_id": "Access ID",
          "access_secret": "Access secret",
          "device_id": "Device ID"
        }
      },
      "salt": {
        "title": "Saltwater system (local)",
        "data": {
          "device_id": "Device ID",
          "local_key": "Local key",
          "host": "IP address",
          "version": "Protocol version"
        }
      },
      "pump": {
        "title": "Sand filter pump",
        "description": "How is your pump controlled?",
        "data": { "pump_mode": "Pump type" }
      },
      "pump_tuya": {
        "title": "Tuya pump (local)",
        "data": {
          "device_id": "Device ID",
          "local_key": "Local key",
          "host": "IP address",
          "version": "Protocol version",
          "pump_on_dp": "On/off data point"
        }
      },
      "pump_entity": {
        "title": "Existing pump entity",
        "description": "Link any pump (any brand) by selecting its switch and, optionally, its power/energy sensors.",
        "data": {
          "pump_switch": "Pump switch",
          "pump_power": "Power sensor (optional)",
          "pump_energy": "Energy sensor (optional)"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Intex Pool",
        "description": "The credentials were rejected — usually because the Tuya local key rotated after the device was re-paired in the app. Enter the current value(s).",
        "data": {
          "local_key": "Local key",
          "pump_local_key": "Pump local key",
          "access_secret": "Cloud access secret"
        }
      },
      "reconfigure_user": {
        "title": "Reconfigure Intex Pool",
        "description": "Re-enter your Tuya cloud credentials to re-detect your devices — useful after replacing a device (it gets a new id).",
        "data": {
          "region": "Region",
          "access_id": "Access ID",
          "access_secret": "Access secret"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect — check the details and that the device is reachable.",
      "invalid_auth": "Credentials rejected — the local key or cloud secret is wrong (the local key changes when the device is re-paired).",
